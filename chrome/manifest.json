{
  "manifest_version": 3,
  "name": "Dashboard & Zwischenablage",
  "version": "3.3",
  "description": "Dein persönliches Dashboard mit Kanban-Board und Zwischenablage für schnelles Speichern von Texten und Bildern.",
  "action": {
    "default_title": "Dashboard öffnen",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}